<% content_for :title, "#{@bike.make} #{@bike.model}" %>

<h1><%= @bike.make %> <%= @bike.model %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p>
      <strong>Owner:</strong>
      <%= link_to @bike.customer.name, customer_path(@bike.customer) %>
    </p>

    <p><strong>Colour:</strong> <%= @bike.colour %></p>
    <p><strong>Serial number:</strong> <%= @bike.serial_number %></p>
  </div>
</div>

<h2>Repair history</h2>

<div class="mb-3">
  <%= link_to "New repair for this bike",
      new_repair_path(bike_id: @bike.id),
      class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>State</th>
        <th>Promised day</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    This bike has no repairs.
  </div>
<% end %>

<div class="d-flex gap-2">
  <%= link_to "Edit bike",
      edit_bike_path(@bike),
      class: "btn btn-primary" %>

  <%= button_to "Delete bike",
      bike_path(@bike),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Delete #{@bike.make} #{@bike.model} #{@bike.serial_number}?"
        }
      } %>

  <%= link_to "Back to bikes",
      bikes_path,
      class: "btn btn-outline-secondary" %>
</div>