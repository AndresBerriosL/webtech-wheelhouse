<h1>Services</h1>

<p>These are some of the services offered at Wheelhouse.</p>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Service</th>
      <th>Price</th>
    </tr>
  </thead>

  <tbody>
    <% @services.each do |service| %>
      <tr>
        <td><%= service.name %></td>
        <td>$<%= service.current_price %></td>
      </tr>
    <% end %>
  </tbody>
</table>