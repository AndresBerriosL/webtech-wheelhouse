<%= form_with model: staff_member do |form| %>
  <% if staff_member.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(staff_member.errors.count, "error") %> prevented this staff member from being saved:</h2>

      <ul class="mb-0">
        <% staff_member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>

    <%= form.text_field :name,
        class: "form-control #{'is-invalid' if staff_member.errors[:name].any?}" %>

    <% staff_member.errors.full_messages_for(:name).each do |message| %>
      <div class="invalid-feedback">
        <%= message %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :role, class: "form-label" %>

    <%= form.text_field :role,
        class: "form-control #{'is-invalid' if staff_member.errors[:role].any?}" %>

    <% staff_member.errors.full_messages_for(:role).each do |message| %>
      <div class="invalid-feedback">
        <%= message %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>

    <%= link_to "Cancel",
        staff_member.persisted? ? staff_member_path(staff_member) : staff_members_path,
        class: "btn btn-outline-secondary" %>
  </div>
<% end %>