<tr class="<%= 'table-danger' if repair.overdue? %>">
  <td><%= link_to "Repair ##{repair.id}", repair_path(repair) %></td>
  <td><%= link_to "#{repair.bike.make} #{repair.bike.model}", bike_path(repair.bike) %></td>
  <td><%= link_to repair.customer.name, customer_path(repair.customer) %></td>
  <td><%= repair.state.humanize %></td>
  <td><%= repair.promised_on.strftime("%d %b %Y") %></td>
</tr>