<% content_for :title, "Customers" %>

<h1>Customers</h1>

<div class="mb-3">
  <%= link_to "New customer", new_customer_path, class: "btn btn-primary" %>
</div>

<% if @customers.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Name</th>
        <th>Phone</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customers %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    There are no customers yet.
  </div>
<% end %>