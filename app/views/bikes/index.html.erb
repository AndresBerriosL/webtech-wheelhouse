<% content_for :title, "Bikes" %>

<h1>Bikes</h1>

<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Colour</th>
        <th>Serial number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    There are no bikes yet.
  </div>
<% end %>