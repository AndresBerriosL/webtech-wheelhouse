<% content_for :title, @customer.name %>

<h1><%= @customer.name %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Phone:</strong> <%= @customer.phone %></p>
  </div>
</div>

<h2>Bikes</h2>

<div class="mb-3">
  <%= link_to "New bike for #{@customer.name}",
      new_bike_path(customer_id: @customer.id),
      class: "btn btn-primary" %>
</div>

<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Colour</th>
        <th>Serial number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    This customer has no bikes.
  </div>
<% end %>

<div class="d-flex gap-2">
  <%= link_to "Edit customer",
      edit_customer_path(@customer),
      class: "btn btn-primary" %>

  <%= button_to "Delete customer",
      customer_path(@customer),
      method: :delete,
      class: "btn btn-danger",
      form: {
        data: {
          turbo_confirm: "Delete #{@customer.name}?"
        }
      } %>

  <%= link_to "Back to customers",
      customers_path,
      class: "btn btn-outline-secondary" %>
</div>