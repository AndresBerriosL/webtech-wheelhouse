<% content_for :title, "Repairs" %>

<h1>Repairs</h1>

<div class="mb-3">
  <%= link_to "New repair", new_repair_path, class: "btn btn-primary" %>
</div>

<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>State</th>
        <th>Promised day</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    There are no repairs yet.
  </div>
<% end %>