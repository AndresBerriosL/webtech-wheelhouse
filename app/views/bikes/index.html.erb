<% content_for :title, "Bikes" %>

<h1>Bikes</h1>
<div class="mb-3">
  <%= link_to "New bike", new_bike_path, class: "btn btn-primary" %>
</div>

<% if @bikes.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Bike</th>
        <th>Colour</th>
        <th>Serial number</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    There are no bikes yet.
  </div>
<% end %>