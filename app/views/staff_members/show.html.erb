<% content_for :title, @staff_member.name %>

<h1><%= @staff_member.name %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Role:</strong> <%= @staff_member.role.humanize %></p>
  </div>
</div>

<h2>Repairs</h2>

<% if @repairs.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Repair</th>
        <th>Bike</th>
        <th>Customer</th>
        <th>State</th>
        <th>Promised day</th>
      </tr>
    </thead>
    <tbody>
      <%= render @repairs %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    This staff member has no assigned repairs.
  </div>
<% end %>

<%= link_to "Back to staff", staff_members_path, class: "btn btn-outline-secondary" %>