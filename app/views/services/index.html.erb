<% content_for :title, "Services" %>

<h1>Services</h1>

<% if @services.any? %>
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Service</th>
        <th>Current price</th>
      </tr>
    </thead>
    <tbody>
      <%= render @services %>
    </tbody>
  </table>
<% else %>
  <div class="alert alert-secondary">
    There are no services yet.
  </div>
<% end %>